# ============================================================
# ИСКЛЮЧЕНИЯ (ФАЙЛЫ, КОТОРЫЕ НУЖНО КОММИТИТЬ)
# ============================================================

# Но НЕ игнорируем example конфиги
!config.example.json
!*.example
!*.example.*

# Но НЕ игнорируем тестовые данные, если они нужны
!tests/data/
!tests/fixtures/
!tests/mocks/

# Но НЕ игнорируем документацию
!*.md
!*.rst
!*.txt

# Но НЕ игнорируем важные ресурсы
!Resources/
!Resources/*
!Icons/
!Icons/*
!Sounds/
!Sounds/*
